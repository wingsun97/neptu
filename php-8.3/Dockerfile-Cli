# syntax=docker/dockerfile:1

# =========================
# Stage 1: Build PHP extensions
# =========================
# 使用已有 grpc 预编译的镜像，避免编译 grpc 耗时
FROM ghcr.io/wingsun97/php-cli:8.3-grpc AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagickwand-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pecl install redis igbinary imagick \
    && CFLAGS="-Wno-incompatible-pointer-types" pecl install seaslog \
    && docker-php-ext-enable redis igbinary seaslog imagick \
    && rm -rf /tmp/pear

# =========================
# Stage 2: Runtime image
# =========================
FROM ghcr.io/wingsun97/php-cli:8.3-grpc

# Copy all compiled extensions（含 grpc/redis/igbinary/seaslog/imagick）
COPY --from=builder /usr/local/lib/php/extensions/ /usr/local/lib/php/extensions/
COPY --from=builder /usr/local/etc/php/conf.d/ /usr/local/etc/php/conf.d/

# Install runtime library dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libmagickwand-6.q16-6 \
    && rm -rf /var/lib/apt/lists/*

# Install composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Custom PHP config
COPY php.ini /usr/local/etc/php/
COPY conf.d/*.ini /usr/local/etc/php/conf.d/

WORKDIR /app


